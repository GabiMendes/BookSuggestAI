# Copie este arquivo para .env e preencha com suas chaves

# Google OAuth 2.0 - Cole aqui as credenciais do Google Cloud Console
GOOGLE_CLIENT_ID="12345678901-your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="ABC0DEF-1234567890-AB1-CC-D333-e"
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Google Gemini AI - Cole aqui a API Key do AI Studio
GEEMINI_API_KEY=AEioU-SAMPLE-KEY-1234567890abcdefg

# Configurações da aplicação
SESSION_SECRET=minha_chave_super_secreta_e_longa_para_sessoes_do_booksuggests_ai
DB_PATH=./data/booksuggests.db

# Configurações de desenvolvimento
GIN_MODE=debug
LOG_LEVEL=info
